if(NOT DEFINED ROOT)
  message(FATAL_ERROR "ROOT is required")
endif()
file(STRINGS "${ROOT}/models/artifacts.tsv" records)
list(POP_FRONT records header)
if(NOT header STREQUAL "path\tsha256\tbytes\tdata_rows")
  message(FATAL_ERROR "Invalid model identity header")
endif()
set(expected)
foreach(record IN LISTS records)
  string(REPLACE "\t" ";" fields "${record}")
  list(LENGTH fields columns)
  if(NOT columns EQUAL 4)
    message(FATAL_ERROR "Incomplete model identity row")
  endif()
  list(GET fields 0 relative)
  list(GET fields 1 digest)
  list(GET fields 2 bytes)
  list(GET fields 3 data_rows)
  if(NOT relative MATCHES "^[a-z][a-z0-9_/-]*\\.tsv$" OR
     NOT digest MATCHES "^[0-9a-f]+$" OR NOT bytes MATCHES "^[0-9]+$" OR
     NOT data_rows MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Invalid model identity fields")
  endif()
  string(LENGTH "${digest}" digest_length)
  set(path "${ROOT}/models/${relative}")
  if(NOT digest_length EQUAL 64 OR NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    message(FATAL_ERROR "Missing or malformed model snapshot: ${relative}")
  endif()
  file(SHA256 "${path}" actual_digest)
  file(SIZE "${path}" actual_bytes)
  file(STRINGS "${path}" rows)
  list(LENGTH rows actual_rows)
  math(EXPR actual_rows "${actual_rows} - 1")
  if(NOT actual_digest STREQUAL digest OR NOT actual_bytes EQUAL bytes OR
     NOT actual_rows EQUAL data_rows)
    message(FATAL_ERROR "Model snapshot identity changed: ${relative}")
  endif()
  list(APPEND expected "${path}")
endforeach()
file(GLOB_RECURSE actual "${ROOT}/models/*.tsv")
list(REMOVE_ITEM actual "${ROOT}/models/artifacts.tsv")
list(SORT expected)
list(SORT actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Model snapshots and identity manifest disagree")
endif()
