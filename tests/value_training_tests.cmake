cmake_minimum_required(VERSION 3.16)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(header "th08_branch_dataset_v1\t24\t64\t24\nepisode\tseed\tstage\tdifficulty\tshot\tspell\tupdate\tproposal\tstatus\tnative_updates\tprefix_sha256")
foreach(name IN ITEMS x y travel_x travel_y wall_left wall_right wall_top wall_bottom last_dx last_dy focused base_score local_real local_ghost local_spawning local_actors local_canonical_gap forecast_boxes forecast_lasers forecast_risk youkai global_bullets global_ghosts global_lasers)
  string(APPEND header "\t${name}")
endforeach()
foreach(split IN ITEMS train tune)
  set(seed 1)
  if(split STREQUAL tune)
    set(seed 2)
  endif()
  string(REPEAT "${seed}" 64 episode)
  string(REPEAT b 64 prefix)
  file(WRITE "${WORK}/${split}.tsv" "${header}\n")
  foreach(index RANGE 0 63)
    math(EXPR positive "${index} % 2")
    math(EXPR update "128 + ${index}")
    set(status death)
    set(updates 12)
    set(x -1)
    if(positive)
      set(status survived)
      set(updates 64)
      set(x 1)
    endif()
    set(row "${episode}\t${seed}\t5\t3\t0\t107\t${update}\t0\t${status}\t${updates}\t${prefix}\t${x}")
    foreach(feature RANGE 1 23)
      string(APPEND row "\t0")
    endforeach()
    file(APPEND "${WORK}/${split}.tsv" "${row}\n")
  endforeach()
endforeach()
execute_process(COMMAND "${TRAINER}" "${WORK}/train.tsv" "${WORK}/tune.tsv" "${WORK}/weights.tsv"
  RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE error)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Value fit failed: ${error}")
endif()
file(WRITE "${WORK}/training.json" "${report}")
string(REGEX MATCH "\"episode_weighted_bce\":([0-9.eE+-]+)" match "${report}")
if(NOT match OR NOT CMAKE_MATCH_1 LESS 0.2)
  message(FATAL_ERROR "Value training did not learn the independent separable fixture")
endif()
execute_process(COMMAND "${TRAINER}" "${WORK}/train.tsv" "${WORK}/tune.tsv" "${WORK}/repeat.tsv"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
file(SHA256 "${WORK}/weights.tsv" first)
file(SHA256 "${WORK}/repeat.tsv" second)
if(NOT result STREQUAL "0" OR NOT first STREQUAL second)
  message(FATAL_ERROR "Fixed full-batch training was not reproducible: ${error}")
endif()
execute_process(COMMAND "${TRAINER}" "${WORK}/train.tsv" "${WORK}/train.tsv" "${WORK}/overlap.tsv"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(result STREQUAL "0" OR EXISTS "${WORK}/overlap.tsv")
  message(FATAL_ERROR "Training/tuning seed overlap accepted")
endif()
file(READ "${WORK}/train.tsv" bad)
string(REPLACE "\tsurvived\t64\t" "\tfault\t64\t" bad "${bad}")
file(WRITE "${WORK}/fault.tsv" "${bad}")
execute_process(COMMAND "${TRAINER}" "${WORK}/fault.tsv" "${WORK}/tune.tsv" "${WORK}/fault-model.tsv"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(result STREQUAL "0" OR EXISTS "${WORK}/fault-model.tsv")
  message(FATAL_ERROR "Native branch fault entered model training")
endif()
