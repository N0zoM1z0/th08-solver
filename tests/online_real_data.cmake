cmake_minimum_required(VERSION 3.16)
# A complete forward-only stage, fresh action execution and natural replay. This
# checks native agreement, not an independent physics or retail oracle.
include("${CMAKE_CURRENT_LIST_DIR}/headless_report_checks.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(profile --stage 2 --difficulty 3 --seed 0 --shot 0 --horizon 32 --beam 192
  --reach-filter 1 --frames 60000 --seconds 900)
function(run name expected)
  execute_process(COMMAND "${EXECUTABLE}" --dat "${DAT}" --out "${WORK}/${name}"
    ${profile} ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr
    TIMEOUT 930)
  if(NOT result STREQUAL "${expected}")
    message(FATAL_ERROR "${name}: expected exit ${expected}, got ${result}: ${stdout} ${stderr}")
  endif()
endfunction()
function(expect report key expected)
  string(REGEX MATCH "\"${key}\":[ ]*${expected}([,} \r\n\t]|$)" found "${report}")
  if(NOT found)
    message(FATAL_ERROR "Expected ${key}=${expected}: ${report}")
  endif()
endfunction()
run(solve 0)
file(READ "${WORK}/solve/online.json" solved)
file(SHA256 "${DAT}" dat_hash)
file(SHA256 "${EXECUTABLE}" binary_hash)
file(SHA256 "${WORK}/solve/online.actions" action_hash)
expect("${solved}" outcome "\"complete\"")
expect("${solved}" dat_sha256 "\"${dat_hash}\"")
expect("${solved}" binary_sha256 "\"${binary_hash}\"")
expect("${solved}" actions_sha256 "\"${action_hash}\"")
expect("${solved}" future_native_updates 0)
expect("${solved}" rewinds 0)
expect("${solved}" deadline_enforced false)
expect("${solved}" component_profiled false)
if(EXISTS "${WORK}/solve/components.json")
  message(FATAL_ERROR "Disabled profiling emitted a component report")
endif()
expect("${solved}" deaths 0)
expect("${solved}" control_updates 0)
field("${solved}" frames frames)
foreach(key IN ITEMS native_update_attempts native_updates calculation_updates decisions)
  expect("${solved}" "${key}" "${frames}")
endforeach()
file(STRINGS "${WORK}/solve/online.actions" actions)
list(LENGTH actions count)
if(NOT count EQUAL frames OR NOT frames GREATER 10000)
  message(FATAL_ERROR "Incomplete stage tape: ${solved}")
endif()
execute_process(COMMAND "${VERIFIER}" --dat "${DAT}" --stage 2 --difficulty 3 --seed 0
  --shot 0 --out "${WORK}/verify" --verify "${WORK}/solve/online.actions"
  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 60)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Fresh native verification failed: ${stdout} ${stderr}")
endif()
file(READ "${WORK}/verify/verify.json" verified)
expect("${verified}" verified true)
expect("${verified}" complete_at "${frames}")
expect("${verified}" death_updates 0)
foreach(key IN ITEMS frames score rng_seed rng_draws calculation_updates control_updates actions_sha256)
  field("${solved}" "${key}" a)
  field("${verified}" "${key}" b)
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "Fresh verification differs at ${key}: ${a} vs ${b}")
  endif()
endforeach()
execute_process(COMMAND "${CHECKER}" "${DAT}" "${WORK}/verify/th8_verify.rpy" "${WORK}/replay.rows"
  RESULT_VARIABLE result OUTPUT_VARIABLE replay ERROR_VARIABLE stderr TIMEOUT 60)
file(WRITE "${WORK}/replay.json" "${replay}")
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Natural replay failed: ${replay} ${stderr}")
endif()
foreach(key IN ITEMS finished natural)
  expect("${replay}" "${key}" true)
endforeach()
expect("${replay}" rows "${frames}")
expect("${replay}" death_rows 0)
expect("${replay}" bomb_input_rows 0)
field("${solved}" score score)
expect("${replay}" endScore "${score}")
expect("${replay}" stage 1)

# Complete prefixes terminate without policy decisions; budget exhaustion remains
# a distinct non-success. Both still account for every executed native update.
run(exact 0 --prefix "${WORK}/solve/online.actions" --profile-components 1)
file(READ "${WORK}/exact/online.json" exact)
expect("${exact}" outcome "\"complete\"")
expect("${exact}" prefix_frames "${frames}")
expect("${exact}" decisions 0)
expect("${exact}" native_update_attempts "${frames}")
file(READ "${WORK}/exact/components.json" prefix_components)
expect("${prefix_components}" decisions 0)
expect("${prefix_components}" capture_seconds 0)
expect("${prefix_components}" policy_seconds 0)
expect("${prefix_components}" live_native_seconds_excluding_file_io 0)
foreach(key IN ITEMS frames score rng_seed rng_draws calculation_updates actions_sha256)
  field("${solved}" "${key}" a)
  field("${exact}" "${key}" b)
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "Complete prefix differs at ${key}")
  endif()
endforeach()
run(budget 3 --frames 4)
file(READ "${WORK}/budget/online.json" budget)
expect("${budget}" outcome "\"budget\"")
expect("${budget}" native_updates 4)
run(profiled 3 --frames 4 --profile-components 1 --log-every 1)
file(READ "${WORK}/profiled/online.json" profiled)
expect("${profiled}" component_profiled true)
file(SHA256 "${WORK}/budget/online.actions" budget_hash)
file(SHA256 "${WORK}/profiled/online.actions" profiled_hash)
if(NOT budget_hash STREQUAL profiled_hash)
  message(FATAL_ERROR "Component profiling changed native input decisions")
endif()
file(READ "${WORK}/profiled/components.json" components)
expect("${components}" instrumented true)
expect("${components}" decisions 4)
expect("${components}" actions_sha256 "\"${profiled_hash}\"")
expect("${components}" binary_sha256 "\"${binary_hash}\"")
run(overflow 2 --seed 4294967296)
if(EXISTS "${WORK}/overflow")
  message(FATAL_ERROR "Invalid checkpoint was accepted after integer narrowing")
endif()
# A fixed idle prefix tests Native failure reporting without depending on solver
# success. The deathbomb window is already an NMNB failure, before lives update.
string(REPEAT "0\n" 5000 idle_prefix)
file(WRITE "${WORK}/idle-prefix.actions" "${idle_prefix}")
execute_process(COMMAND "${EXECUTABLE}" --dat "${DAT}" --out "${WORK}/death-window"
  --stage 1 --difficulty 3 --seed 0 --shot 0 --horizon 24 --frames 5000 --seconds 300
  --prefix "${WORK}/idle-prefix.actions"
  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 330)
if(NOT result STREQUAL "4")
  message(FATAL_ERROR "Death-window prefix did not fail natively: ${stdout} ${stderr}")
endif()
file(READ "${WORK}/death-window/online.json" death_window)
expect("${death_window}" outcome "\"death\"")
expect("${death_window}" failure "\"death\"")
expect("${death_window}" final_player_state 2)
expect("${death_window}" deaths 0)
expect("${death_window}" decisions 0)
field("${death_window}" frames fatal_frames)
if(NOT fatal_frames GREATER 0 OR fatal_frames GREATER 5000)
  message(FATAL_ERROR "Death-window fixture did not execute the bounded prefix")
endif()
expect("${death_window}" native_update_attempts "${fatal_frames}")
expect("${death_window}" native_updates "${fatal_frames}")
message(STATUS "Complete online stage and replay contract passed at ${frames} updates")
