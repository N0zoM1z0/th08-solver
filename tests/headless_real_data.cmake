  field("${short_replay}" frames short_frames)
  if(NOT short_outcome STREQUAL "\"tape_end\"" OR NOT short_frames STREQUAL "50")
    message(FATAL_ERROR "Strict replay silently continued beyond its tape")
  endif()
  run("${EXECUTABLE}" "${WORK}/id203-resume.json" 2 ${args} --strategy spell-portfolio
    --resume-prefix "${WORK}/id203-control.prefix" --actions "${WORK}/id203-resume.actions")
  file(READ "${WORK}/id203-resume.json" resumed)
  file(READ "${WORK}/spell203-observed-beam-seed0.json" initial)
  agree("${initial}" "${resumed}")
  file(SHA256 "${WORK}/id203-resume.actions" resumed_tape)
  file(SHA256 "${WORK}/spell203-observed-beam-seed0.actions" initial_tape)
  if(NOT resumed_tape STREQUAL initial_tape)
    message(FATAL_ERROR "Native prefix continuation changed the control tape")
  endif()
  if(REPAIR_EXECUTABLE)
    set(repair_search_reused false)
    if(REPAIR_RESULT_DIR)
      set(repair_search_reused true)
      set(directory "${REPAIR_RESULT_DIR}")
      file(READ "${directory}/summary.json" cached_search)
      field("${cached_search}" child_executable_sha256 cached_child)
      field("${cached_search}" repair_executable_sha256 cached_repair)
      file(SHA256 "${EXECUTABLE}" current_child)
      file(SHA256 "${REPAIR_EXECUTABLE}" current_repair)
      if(NOT cached_child STREQUAL "\"${current_child}\"" OR
          NOT cached_repair STREQUAL "\"${current_repair}\"")
        message(FATAL_ERROR "Existing repair results belong to different executable bytes")
      endif()
    else()
      set(directory "${WORK}/id203-repair")
      file(REMOVE_RECURSE "${directory}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=DISPLAY --unset=WAYLAND_DISPLAY
      "${REPAIR_EXECUTABLE}" --executable "${EXECUTABLE}" --dat "${DAT}"
      --stage extra --spell-id 203 --difficulty 4 --seed 0 --frames 15000 --seconds 600
      --output-dir "${directory}" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "Bounded native repair failed: ${result}: ${stdout}${stderr}")
    endif()
    endif()
    file(READ "${directory}/summary.json" search)
    field("${search}" outcome repair_outcome)
    if(NOT repair_outcome STREQUAL "\"complete\"")
      message(FATAL_ERROR "Repair artifact is not a complete verified search")
    endif()
    field("${search}" selected_case selected)
    string(REPLACE "\"" "" selected "${selected}")
    file(READ "${directory}/${selected}.json" original)
    field("${original}" frames frames)
    field("${original}" prefix_frame prefix_frame)
    if(NOT frames STREQUAL "5492")
      message(FATAL_ERROR "ID203 repair changed complete wrapper boundary")
    endif()
    set(args --stage extra --spell-id 203 --difficulty 4 --seed 0 --frames 15000
      --prefix-frame "${prefix_frame}" --replay "${directory}/${selected}.actions")
    run("${EXECUTABLE}" "${WORK}/id203-repaired-replay.json" 0 ${args})
    file(READ "${WORK}/id203-repaired-replay.json" replay)
    agree("${original}" "${replay}")
    set(record "{\"case\":\"spell203-bounded-native-repair\",\"execution\":${original},\"replay\":${replay},\"search\":${search},\"search_reused\":${repair_search_reused}")
    if(COMPARE_EXECUTABLE)
      run("${COMPARE_EXECUTABLE}" "${WORK}/id203-repaired-comparison.json" 0 ${args})
      file(READ "${WORK}/id203-repaired-comparison.json" comparison)
      agree("${original}" "${comparison}")
      string(APPEND record ",\"comparison_replay\":${comparison}")
    endif()
    string(APPEND record "}")
    list(APPEND records "${record}")
    message(STATUS "ID203 bounded native repair: complete5492; fresh replay agrees")
  endif()
  write_case_group(id203 ${group_begin})
endif()
if(CASE_GROUP STREQUAL "id203")
  return()
endif()

