    endif()
  endforeach()
  # Strict replay must not silently become prefix continuation.
  file(STRINGS "${WORK}/spell203-observed-beam-seed0.actions" prefix LIMIT_COUNT 50)
  string(JOIN "\n" prefix_text ${prefix})
  file(WRITE "${WORK}/id203-control.prefix" "${prefix_text}\n")
