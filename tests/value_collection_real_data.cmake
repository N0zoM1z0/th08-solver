cmake_minimum_required(VERSION 3.16)
include("${CMAKE_CURRENT_LIST_DIR}/headless_report_checks.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
foreach(scene IN ITEMS 107 202)
  set(stage 5)
  set(difficulty 3)
  if(scene EQUAL 202)
    set(stage 8)
    set(difficulty 4)
  endif()
  foreach(collect IN ITEMS 0 1)
    execute_process(COMMAND "${COLLECTOR}" --dat "${DAT}" --out "${WORK}/${scene}-${collect}"
      --stage "${stage}" --spell "${scene}" --difficulty "${difficulty}" --shot 0 --seed 46445
      --frames 640 --stride 128 --checkpoints 4 --collect "${collect}"
      RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 40)
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "Native value collection failed: ${stdout} ${stderr}")
    endif()
  endforeach()
  file(READ "${WORK}/${scene}-0/collection.json" plain)
  file(READ "${WORK}/${scene}-1/collection.json" labeled)
  foreach(key IN ITEMS outcome nominal_updates score rng_seed rng_draws nominal_trace_digest calculation_updates actions_sha256)
    field("${plain}" "${key}" before)
    field("${labeled}" "${key}" after)
    if(NOT before STREQUAL after)
      message(FATAL_ERROR "Native branch sampling changed parent ${key}")
    endif()
  endforeach()
  field("${labeled}" nominal_updates updates)
  field("${labeled}" bad_branches bad)
  field("${labeled}" branches branches)
  field("${labeled}" label_native_updates label_updates)
  if(NOT updates EQUAL 640 OR NOT bad EQUAL 0 OR NOT branches GREATER 0 OR NOT label_updates GREATER 0)
    message(FATAL_ERROR "Collection missed the real checkpoint/label contract")
  endif()
  file(SHA256 "${WORK}/${scene}-0/nominal.actions" before)
  file(SHA256 "${WORK}/${scene}-1/nominal.actions" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Native branch sampling changed exact parent inputs")
  endif()
  file(STRINGS "${WORK}/${scene}-1/branch-inputs.tsv" branch_inputs)
  list(LENGTH branch_inputs input_rows)
  math(EXPR expected_rows "${branches} + 1")
  if(NOT input_rows EQUAL expected_rows)
    message(FATAL_ERROR "Native branch labels lost their explicit input sequences")
  endif()
endforeach()
