cmake_minimum_required(VERSION 3.16)
include("${CMAKE_CURRENT_LIST_DIR}/headless_report_checks.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
foreach(scene IN ITEMS 107 202)
  set(stage 5)
  set(difficulty 3)
  if(scene EQUAL 202)
    set(stage 8)
    set(difficulty 4)
  endif()
  foreach(mode IN ITEMS plain held replan)
    set(collect 1)
    set(continuation held-last)
    if(mode STREQUAL "plain")
      set(collect 0)
    elseif(mode STREQUAL "replan")
      set(continuation replan-h24)
    endif()
    execute_process(COMMAND "${COLLECTOR}" --dat "${DAT}" --out "${WORK}/${scene}-${mode}"
      --stage "${stage}" --spell "${scene}" --difficulty "${difficulty}" --shot 0 --seed 46445
      --frames 640 --stride 128 --checkpoints 4 --collect "${collect}" --continuation "${continuation}"
      RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 40)
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "Native value collection failed: ${stdout} ${stderr}")
    endif()
  endforeach()
  file(READ "${WORK}/${scene}-plain/collection.json" plain)
  foreach(key IN ITEMS rows branches label_native_updates)
    field("${plain}" "${key}" count)
    if(NOT count EQUAL 0)
      message(FATAL_ERROR "The plain Native control unexpectedly sampled branches")
    endif()
  endforeach()
  foreach(mode IN ITEMS held replan)
  file(READ "${WORK}/${scene}-${mode}/collection.json" labeled)
  foreach(key IN ITEMS outcome nominal_updates score rng_seed rng_draws nominal_trace_digest calculation_updates actions_sha256)
    field("${plain}" "${key}" before)
    field("${labeled}" "${key}" after)
    if(NOT before STREQUAL after)
      message(FATAL_ERROR "Native branch sampling changed parent ${key}")
    endif()
  endforeach()
  field("${labeled}" nominal_updates updates)
  field("${labeled}" bad_branches bad)
  field("${labeled}" branches branches)
  field("${labeled}" label_native_updates label_updates)
  if(NOT updates EQUAL 640 OR NOT bad EQUAL 0 OR NOT branches GREATER 0 OR NOT label_updates GREATER 0)
    message(FATAL_ERROR "Collection missed the real checkpoint/label contract")
  endif()
  file(SHA256 "${WORK}/${scene}-plain/nominal.actions" before)
  file(SHA256 "${WORK}/${scene}-${mode}/nominal.actions" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Native branch sampling changed exact parent inputs")
  endif()
  file(STRINGS "${WORK}/${scene}-${mode}/branch-inputs.tsv" branch_inputs)
  list(LENGTH branch_inputs input_rows)
  math(EXPR expected_rows "${branches} + 1")
  if(NOT input_rows EQUAL expected_rows)
    message(FATAL_ERROR "Native branch labels lost their explicit input sequences")
  endif()
  if(mode STREQUAL "replan")
    field("${labeled}" continuation continuation)
    field("${labeled}" label_policy_decisions decisions)
    field("${labeled}" label_native_attempts attempts)
    if(NOT continuation STREQUAL "\"replan-h24-after24-v1\"" OR NOT decisions GREATER 0 OR NOT attempts EQUAL label_updates)
      message(FATAL_ERROR "Replan collection omitted its target or charged child work")
    endif()
    file(STRINGS "${WORK}/${scene}-${mode}/dataset.tsv" version LIMIT_COUNT 1)
    if(NOT version STREQUAL "th08_branch_dataset_v2\t24\t64\t24\treplan-h24-after24-v1")
      message(FATAL_ERROR "Native replanning labels acquired the wrong target version")
    endif()
    file(STRINGS "${WORK}/${scene}-${mode}/branch-rollouts.tsv" rollouts)
    list(LENGTH rollouts rollout_rows)
    if(NOT rollout_rows EQUAL expected_rows)
      message(FATAL_ERROR "A Native branch lost its literal executed sequence")
    endif()
    math(EXPR last_row "${expected_rows} - 1")
    foreach(index RANGE 1 ${last_row})
      list(GET rollouts ${index} row)
      string(REPLACE "\t" ";" columns "${row}")
      list(GET columns 5 updates)
      list(GET columns 6 attempted)
      list(GET columns 7 decisions)
      list(GET columns 8 warmed)
      list(GET columns 10 inputs)
      string(REPLACE "," ";" inputs "${inputs}")
      list(LENGTH inputs submitted)
      if(NOT submitted EQUAL updates OR NOT attempted EQUAL updates)
        message(FATAL_ERROR "Executed branch inputs no longer cover every Native update")
      endif()
      set(expected_decisions 0)
      if(updates GREATER 24)
        math(EXPR expected_decisions "${updates} - 24")
      endif()
      math(EXPR expected_warm "${updates} - 1")
      if(expected_warm GREATER 23)
        set(expected_warm 23)
      endif()
      if(NOT decisions EQUAL expected_decisions OR NOT warmed EQUAL expected_warm)
        message(FATAL_ERROR "Native replanning crossed the explicit after-24 latch boundary")
      endif()
      list(GET branch_inputs ${index} proposal_row)
      string(REPLACE "\t" ";" proposal_columns "${proposal_row}")
      list(GET proposal_columns 4 proposed)
      string(REPLACE "," ";" proposed "${proposed}")
      math(EXPR last_input "${submitted} - 1")
      foreach(step RANGE 0 ${last_input})
        list(GET inputs ${step} input)
        math(EXPR invalid "${input} & ~245")
        math(EXPR shooting "${input} & 1")
        if(invalid OR NOT shooting)
          message(FATAL_ERROR "Native continuation introduced unsupported/bomb input")
        endif()
        if(step LESS 24)
          set(prefix_index ${step})
          if(prefix_index GREATER 22)
            set(prefix_index 22)
          endif()
          list(GET proposed ${prefix_index} expected_input)
          if(NOT input EQUAL expected_input)
            message(FATAL_ERROR "Native continuation changed the proposed prefix or held update24")
          endif()
        endif()
      endforeach()
    endforeach()
  endif()
  endforeach()
endforeach()

# A shifted sampling grid is a distinct collection of the same nominal parent,
# not a new training parent or an implicit duplicate of absolute stride128 rows.
execute_process(COMMAND "${COLLECTOR}" --dat "${DAT}" --out "${WORK}/107-window"
  --stage 5 --spell 107 --difficulty 3 --shot 0 --seed 46445 --frames 640
  --stride 32 --checkpoints 4 --sample-from 257 --sample-until 321
  --collect 1 --continuation replan-h24
  RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 40)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Windowed Native collection failed: ${stdout} ${stderr}")
endif()
file(READ "${WORK}/107-window/collection.json" windowed)
file(READ "${WORK}/107-replan/collection.json" regular)
foreach(key IN ITEMS episode outcome nominal_updates score rng_seed rng_draws nominal_trace_digest calculation_updates actions_sha256)
  field("${regular}" "${key}" before)
  field("${windowed}" "${key}" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Sampling windows changed parent identity/state at ${key}")
  endif()
endforeach()
field("${regular}" sampling_id before)
field("${windowed}" sampling_id after)
field("${windowed}" checkpoints checkpoints)
field("${windowed}" rows rows)
if(before STREQUAL after OR NOT checkpoints EQUAL 3 OR NOT rows EQUAL 12)
  message(FATAL_ERROR "Sampling window lost its identity or inclusive bounds")
endif()
file(STRINGS "${WORK}/107-window/dataset.tsv" sampled)
list(SUBLIST sampled 2 -1 sampled)
set(index 0)
foreach(row IN LISTS sampled)
  string(REPLACE "\t" ";" columns "${row}")
  list(GET columns 6 update)
  math(EXPR expected "257 + (${index} / 4) * 32")
  if(NOT update EQUAL expected)
    message(FATAL_ERROR "Sampling grid no longer uses the explicit window anchor")
  endif()
  math(EXPR index "${index} + 1")
endforeach()
