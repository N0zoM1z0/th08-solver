function(run_archive name success)
  execute_process(COMMAND "${REPORT}" --root "${WORK}/archive-results"
    --fidelity "${WORK}/fidelity.json" --output "${WORK}/archive-${name}.json"
    --known-binary-sha256 "${binary}" --replay-dir "${WORK}/published"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(success AND NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${name}: expected archive success: ${output}${error}")
  elseif(NOT success AND "${result}" STREQUAL "0")
    message(FATAL_ERROR "${name}: unbound replay was archived")
  endif()
  file(READ "${WORK}/archive-${name}.json" archive_ledger)
  string(FIND "${archive_ledger}${output}${error}" "${WORK}" private_position)
  if(NOT private_position EQUAL -1)
    message(FATAL_ERROR "${name}: archive output disclosed an absolute path")
  endif()
  set(archive_ledger "${archive_ledger}" PARENT_SCOPE)
endfunction()
