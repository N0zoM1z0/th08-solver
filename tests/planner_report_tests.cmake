endif()
file(WRITE "${route_root}/plan.json" "${matrix_plan}")
file(COPY "${WORK}/results/matrix-c16/" DESTINATION "${WORK}/results/matrix-c32")
run_selected(matrix-repeated-attempt TRUE --group matrix-c16 --group matrix-c32 --matrix "${WORK}/matrix.json")
if(NOT selected MATCHES "\"verified_combinations\":1" OR
   NOT selected MATCHES "\"observed_combinations\":1" OR
   NOT selected MATCHES "\"verified_complete_cases\":2" OR
   NOT selected MATCHES "\"native_updates\":90")
  message(FATAL_ERROR "Repeated attempts inflated coverage or lost their separate costs")
endif()
file(MAKE_DIRECTORY "${WORK}/results/matrix-budget/extra-t0-natural-s0")
file(WRITE "${WORK}/results/matrix-budget/extra-t0-natural-s0/plan.json"
  "{\"source_revision\":\"${revision}\",\"stage\":8,\"spell\":-1,\"shot\":0,\"difficulty\":4,\"seed\":0,\"story\":1,\"frames\":3,\"outcome\":\"budget\",\"native_updates\":7,\"options\":{\"stage\":8,\"spell\":-1,\"shot\":0,\"difficulty\":4,\"seed\":0,\"story\":1,\"until_stage\":8,\"final_route\":0}}")
file(WRITE "${WORK}/results/matrix-budget/extra-t0-natural-s0.exit" "3\n")
run_selected(matrix-budget TRUE --group matrix-c16 --group matrix-c32 --group matrix-budget --matrix "${WORK}/matrix.json")
if(NOT selected MATCHES "\"observed_combinations\":2" OR
   NOT selected MATCHES "\"verified_combinations\":1" OR
   NOT selected MATCHES "\"not_yet_verified_combinations\":107" OR
   NOT selected MATCHES "\"failed_cases\":1" OR
   NOT selected MATCHES "\"native_updates\":97")
