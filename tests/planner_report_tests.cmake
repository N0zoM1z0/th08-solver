   NOT extra_steps EQUAL 6 OR NOT extra_checker STREQUAL archive_checker OR
   NOT primary_proof_hash STREQUAL unchanged_primary_hash OR
   archive_ledger MATCHES "private_path|/private/sensitive")
  message(FATAL_ERROR "A fresh archive receipt replaced primary proof/costs or disclosed unknown metadata")
endif()
foreach(change IN ITEMS rows terminal hash)
  if(change STREQUAL "rows")
    string(REPLACE "\"rows\":4" "\"rows\":3" bad_archive "${archive_receipt}")
  elseif(change STREQUAL "terminal")
    string(REPLACE "{\"stage\":1,\"endScore\":10}" "{\"stage\":8,\"endScore\":10}" bad_archive "${archive_receipt}")
  else()
    string(REPLACE "${original_replay_hash}" "${dat}" bad_archive "${archive_receipt}")
  endif()
  file(WRITE "${WORK}/archive-results/story-v2/accounted-rpy-archive.json" "${bad_archive}")
  run_archive("separate-archive-wrong-${change}" FALSE)
endforeach()
file(WRITE "${WORK}/archive-results/story-v2/accounted-rpy-archive.json" "${archive_receipt}")

# New identity cannot hide a contradiction in an already qualified primary run.
foreach(key IN ITEMS dat_sha256 source_revision replay_sha256)
  if(key STREQUAL "source_revision")
    string(REPLACE "${revision}" "ffffffffffffffffffffffffffffffffffffffff" wrong_primary "${bound_replay}")
  elseif(key STREQUAL "dat_sha256")
    string(REPLACE "${dat}" "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" wrong_primary "${bound_replay}")
  else()
    string(REPLACE "${original_replay_hash}" "${dat}" wrong_primary "${bound_replay}")
  endif()
  file(WRITE "${WORK}/archive-results/story-v2/accounted-rpy.json" "${wrong_primary}")
  run_archive("contradictory-primary-${key}" FALSE)
endforeach()
file(WRITE "${WORK}/archive-results/story-v2/accounted-rpy.json" "${accounted_replay}")

# A natural replay alone cannot qualify arbitrary action bytes for publication.
file(WRITE "${WORK}/archive-results/story-v2/accounted/plan.json" "${old_plan}")
file(WRITE "${WORK}/archive-results/story-v2/accounted-verify/verify.json" "${old_verify}")
string(REPLACE "\"rows\":4" "\"rows\":5" old_primary "${accounted_replay}")
string(REPLACE "\"rows\":4" "\"rows\":5" old_archive "${archive_receipt}")
file(WRITE "${WORK}/archive-results/story-v2/accounted-rpy.json" "${old_primary}")
file(WRITE "${WORK}/archive-results/story-v2/accounted-rpy-archive.json" "${old_archive}")
run_archive(missing-action-byte-proof FALSE)
if(NOT archive_ledger MATCHES "missing_archive_actions_binding")
  message(FATAL_ERROR "Legacy action bytes were published without a hash-qualified execution proof")
endif()

# A separately retained legacy binary and fidelity DAT qualify missing original
# producer identities, while the fresh observer binds the exact complete tape.
file(RENAME "${WORK}/archive-results/story-v2" "${WORK}/archive-results/advance-v1")
foreach(kind IN ITEMS plan verify)
  string(REPLACE "\"binary_sha256\":\"${binary}\"," "" legacy_${kind} "${old_${kind}}")
  string(REPLACE "\"dat_sha256\":\"${dat}\"," "" legacy_${kind} "${legacy_${kind}}")
endforeach()
file(WRITE "${WORK}/archive-results/advance-v1/accounted/plan.json" "${legacy_plan}")
file(WRITE "${WORK}/archive-results/advance-v1/accounted-verify/verify.json" "${legacy_verify}")
file(WRITE "${WORK}/archive-results/advance-v1/accounted-rpy.json" "${accounted_replay}")
file(WRITE "${WORK}/archive-results/advance-v1/accounted-rpy-archive.json" "${archive_receipt}")
file(MAKE_DIRECTORY "${WORK}/archive-results/advance-v1/accounted-accounting")
file(WRITE "${WORK}/archive-results/advance-v1/accounted-accounting/verify.json" "${receipt}")
run_archive(legacy-bound-observer TRUE)
if(NOT archive_ledger MATCHES "\"accounting_native_updates\":5" OR
   NOT archive_ledger MATCHES "\"archive_replay_rows\":4" OR
   NOT archive_ledger MATCHES "\"binary_origin\":\"retained_campaign_binary\"")
  message(FATAL_ERROR "Legacy receipt identity or separately incurred costs were lost")
endif()

# Explicit new batches require both successful process receipts. Sidecars must
# never inflate the solver-attempt count, including their .exit files.
file(MAKE_DIRECTORY "${WORK}/results/batch-c16/seed1" "${WORK}/results/batch-c16/seed1-verify"
  "${WORK}/results/batch-c32/pending")
file(WRITE "${WORK}/results/batch-c16/seed1/plan.json" "${stage_plan}")
file(WRITE "${WORK}/results/batch-c16/seed1.exit" "0\n")
file(WRITE "${WORK}/results/batch-c16/seed1-verify/verify.json" "${verify}")
file(WRITE "${WORK}/results/batch-c16/seed1-verify.exit" "0\n")
string(REPLACE "\"rows\":5" "\"replay_target_exe_size\":840704,\"replay_target_exe_checksum\":2724749753,\"replay_target_version\":\"0100d\",\"rows\":5"
  target_replay "${natural_replay}")
file(WRITE "${WORK}/results/batch-c16/seed1-rpy.json" "${target_replay}")
file(WRITE "${WORK}/results/batch-c16/seed1-rpy.exit" "0\n")
function(run_selected name success)
  execute_process(COMMAND "${REPORT}" --root "${WORK}/results" --fidelity "${WORK}/fidelity.json"
    --output "${WORK}/selected-${name}.json" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if((success AND NOT "${result}" STREQUAL "0") OR
     (NOT success AND "${result}" STREQUAL "0"))
    message(FATAL_ERROR "${name}: unexpected result ${result}: ${output}${error}")
  endif()
  if(EXISTS "${WORK}/selected-${name}.json")
    file(READ "${WORK}/selected-${name}.json" selected)
    set(selected "${selected}" PARENT_SCOPE)
  endif()
endfunction()
run_selected(two-groups TRUE --group batch-c16 --group batch-c32)
if(NOT selected MATCHES "\"finalized_cases\":1" OR
   NOT selected MATCHES "\"pending_cases\":1" OR
   NOT selected MATCHES "\"verified_complete_cases\":1" OR
   NOT selected MATCHES "\"process_exit_code\":0" OR
   NOT selected MATCHES "\"replay_target_version\":\"0100d\"")
  message(FATAL_ERROR "Explicit groups lost a case or counted sidecars as solver attempts")
endif()
foreach(kind IN ITEMS verify rpy)
  file(WRITE "${WORK}/results/batch-c16/seed1-${kind}.exit" "124\n")
  run_selected("failed-${kind}-process" FALSE --group batch-c16)
  if(NOT selected MATCHES "process_failed" OR NOT selected MATCHES "\"verified_complete_cases\":0")
    message(FATAL_ERROR "Successful JSON hid a failed ${kind} process")
  endif()
  file(REMOVE "${WORK}/results/batch-c16/seed1-${kind}.exit")
  run_selected("missing-${kind}-process" FALSE --group batch-c16)
  if(NOT selected MATCHES "missing_process_receipt")
    message(FATAL_ERROR "An explicit batch accepted missing ${kind} exit evidence")
  endif()
  file(WRITE "${WORK}/results/batch-c16/seed1-${kind}.exit" "0\n")
endforeach()
string(REPLACE "0100d" "/private/sensitive" unsafe_version "${target_replay}")
file(WRITE "${WORK}/results/batch-c16/seed1-rpy.json" "${unsafe_version}")
run_selected(unsafe-target-version FALSE --group batch-c16)
if(NOT selected MATCHES "invalid_replay_target_version" OR selected MATCHES "/private/sensitive")
  message(FATAL_ERROR "An invalid target version was accepted or disclosed")
endif()
file(WRITE "${WORK}/results/batch-c16/seed1-rpy.json" "${target_replay}")
run_selected(missing-group FALSE --group nonexistent)
run_selected(duplicate-group FALSE --group batch-c16 --group batch-c16)
run_selected(unsafe-group FALSE --group ../batch-c16)

# A replay of the other final route is not a verification of this checkpoint.
file(READ "${WORK}/results/batch-c16/seed1/plan.json" route_plan)
file(READ "${WORK}/results/batch-c16/seed1-verify/verify.json" route_verify)
string(REPLACE "\"options\":{" "\"options\":{\"final_route\":2," explicit_route_plan "${route_plan}")
string(REPLACE "\"options\":{" "\"options\":{\"final_route\":1," wrong_route_verify "${route_verify}")
file(WRITE "${WORK}/results/batch-c16/seed1/plan.json" "${explicit_route_plan}")
file(WRITE "${WORK}/results/batch-c16/seed1-verify/verify.json" "${wrong_route_verify}")
run_selected(wrong-final-route FALSE --group batch-c16)
if(NOT selected MATCHES "verification_checkpoint_mismatch")
  message(FATAL_ERROR "Verification silently changed the requested final route")
endif()
file(WRITE "${WORK}/results/batch-c16/seed1-verify/verify.json" "${route_verify}")
run_selected(missing-final-route FALSE --group batch-c16)
file(WRITE "${WORK}/results/batch-c16/seed1/plan.json" "${route_plan}")

# Retain the final emitted failed prefix separately, with byte hashes and an
# explicit unverified label. It never contributes a successful demonstration.
file(MAKE_DIRECTORY "${WORK}/results/batch-failed/seed1")
string(REPLACE "\"outcome\":\"complete\"" "\"outcome\":\"budget\"" failed_plan "${stage_plan}")
file(WRITE "${WORK}/results/batch-failed/seed1/plan.json" "${failed_plan}")
file(WRITE "${WORK}/results/batch-failed/seed1.exit" "1\n")
set(failed_actions "1\n1\n1\n1\n1\n")
file(WRITE "${WORK}/results/batch-failed/seed1/plan.actions" "${failed_actions}")
run_selected(failed-prefix TRUE --group batch-failed --failed-actions-dir "${WORK}/failed-actions")
file(SHA256 "${WORK}/results/batch-failed/seed1/plan.actions" failed_hash)
file(SHA256 "${WORK}/failed-actions/batch-failed--seed1.actions" archived_failed_hash)
if(NOT selected MATCHES "\"failed_cases\":1" OR
   NOT selected MATCHES "\"verified_complete_cases\":0" OR
   NOT selected MATCHES "\"artifact_role\":\"failed_search_prefix\"" OR
   NOT selected MATCHES "\"execution_verified\":false" OR
   NOT selected MATCHES "${failed_hash}" OR NOT failed_hash STREQUAL archived_failed_hash)
  message(FATAL_ERROR "A failed prefix lost its bytes, hash or unverified role")
endif()
run_selected(failed-prefix-repeat TRUE --group batch-failed --failed-actions-dir "${WORK}/failed-actions")
file(WRITE "${WORK}/results/batch-failed/seed1/plan.actions" "1\n1\n1\n1\n")
run_selected(failed-prefix-count FALSE --group batch-failed --failed-actions-dir "${WORK}/failed-actions")
if(NOT selected MATCHES "failed_prefix_count_mismatch")
  message(FATAL_ERROR "A truncated failed prefix was archived")
endif()
file(WRITE "${WORK}/results/batch-failed/seed1/plan.actions" "2\n1\n1\n1\n1\n")
run_selected(failed-prefix-bomb FALSE --group batch-failed --failed-actions-dir "${WORK}/failed-actions")
file(WRITE "${WORK}/results/batch-failed/seed1/plan.actions" "0\n1\n1\n1\n1\n")
run_selected(failed-prefix-conflict FALSE --group batch-failed --failed-actions-dir "${WORK}/failed-actions")
if(NOT selected MATCHES "archive_artifact_conflict")
  message(FATAL_ERROR "A failed-prefix archive was silently overwritten")
endif()
file(SHA256 "${WORK}/failed-actions/batch-failed--seed1.actions" preserved_hash)
if(NOT preserved_hash STREQUAL failed_hash)
  message(FATAL_ERROR "A rejected failed prefix changed the retained original")
endif()

# A full-run catalog must check the entire path and count unique combinations,
# while preserving repeated attempts and their costs. These are protocol fixtures,
# not native gameplay or retail-equivalence evidence.
execute_process(COMMAND "${MATRIX}" --seed 0 --output "${WORK}/matrix.json"
  RESULT_VARIABLE matrix_result)
if(NOT matrix_result EQUAL 0)
  message(FATAL_ERROR "Cannot generate the route matrix")
endif()
set(route_id easy-t0-a-s0)
set(route_root "${WORK}/results/matrix-c16/${route_id}")
file(MAKE_DIRECTORY "${route_root}" "${route_root}-verify")
string(REPEAT "0\n" 15 route_actions)
file(WRITE "${route_root}/plan.actions" "${route_actions}")
file(SHA256 "${route_root}/plan.actions" route_action_hash)
set(route_options "\"stage\":0,\"spell\":-1,\"shot\":0,\"difficulty\":0,\"seed\":0,\"story\":1,\"until_stage\":8,\"final_route\":1")
set(route_events "")
set(route_from 0)
set(route_index 0)
foreach(route_to IN ITEMS 1 2 4 5 6)
  math(EXPR route_frame "2+3*${route_index}")
  math(EXPR route_calc "1+2*${route_index}")
  if(route_index GREATER 0)
    string(APPEND route_events ",")
  endif()
  string(APPEND route_events "{\"frame\":${route_frame},\"from_stage\":${route_from},\"to_stage\":${route_to},\"calculation_updates_before\":${route_calc},\"calculation_updates_after\":${route_calc}}")
  set(route_from ${route_to})
  math(EXPR route_index "${route_index}+1")
endforeach()
set(route_trajectory "\"calculation_updates\":10,\"control_updates\":5,\"stage_transition_count\":5,\"stage_transitions\":[${route_events}]")
set(route_common "\"source_revision\":\"${revision}\",\"binary_sha256\":\"${binary}\",\"dat_sha256\":\"${dat}\",\"frames\":15,\"score\":10,\"rng_seed\":1,\"rng_draws\":2,${route_trajectory},\"options\":{${route_options}}")
set(matrix_plan "{${route_common},${route_options},\"final_stage\":6,\"outcome\":\"complete\",\"deaths\":0,\"native_updates\":30}")
set(matrix_verify "{${route_common},\"stage\":6,\"verified\":true,\"complete_at\":15,\"death_updates\":0,\"native_updates\":15,\"actions_sha256\":\"${route_action_hash}\"}")
set(matrix_replay "{\"rows\":10,\"steps\":8,\"finished\":true,\"natural\":true,\"death_rows\":0,\"bomb_input_rows\":0,\"stages\":[{\"stage\":0},{\"stage\":1},{\"stage\":2},{\"stage\":4},{\"stage\":5},{\"stage\":6,\"endScore\":10}]}")
file(WRITE "${route_root}/plan.json" "${matrix_plan}")
file(WRITE "${route_root}.exit" "0\n")
file(WRITE "${route_root}-verify/verify.json" "${matrix_verify}")
file(WRITE "${route_root}-verify.exit" "0\n")
file(WRITE "${route_root}-rpy.json" "${matrix_replay}")
file(WRITE "${route_root}-rpy.exit" "0\n")
run_selected(matrix-path TRUE --group matrix-c16 --matrix "${WORK}/matrix.json")
file(SHA256 "${WORK}/matrix.json" matrix_hash)
if(NOT selected MATCHES "\"matrix_sha256\":\"${matrix_hash}\"" OR
   NOT selected MATCHES "\"expected_combinations\":108" OR
   NOT selected MATCHES "\"verified_combinations\":1" OR
   NOT selected MATCHES "\"not_yet_verified_combinations\":107" OR
   NOT selected MATCHES "\"stage_path\":\\[0,1,2,4,5,6\\]")
  message(FATAL_ERROR "The route catalog lost coverage, identity or its full stage path")
endif()
string(REPLACE "\"stage\":4" "\"stage\":3" wrong_path "${matrix_replay}")
file(WRITE "${route_root}-rpy.json" "${wrong_path}")
run_selected(matrix-wrong-replay-path FALSE --group matrix-c16 --matrix "${WORK}/matrix.json")
if(NOT selected MATCHES "matrix_replay_stage_path_mismatch")
  message(FATAL_ERROR "A replay with the right terminal but wrong intermediate stage was counted")
endif()
file(WRITE "${route_root}-rpy.json" "${matrix_replay}")
set(matrix_plan_file "${route_root}/plan.json")
set(matrix_verify_file "${route_root}-verify/verify.json")
foreach(kind IN ITEMS plan verify)
  string(REPLACE "to_stage\":4" "to_stage\":3" wrong_path "${matrix_${kind}}")
  string(REPLACE "from_stage\":4" "from_stage\":3" wrong_path "${wrong_path}")
  file(WRITE "${matrix_${kind}_file}" "${wrong_path}")
endforeach()
run_selected(matrix-wrong-native-path FALSE --group matrix-c16 --matrix "${WORK}/matrix.json")
if(NOT selected MATCHES "matrix_native_stage_path_mismatch")
  message(FATAL_ERROR "Matching plan/verification receipts hid an incorrect native path")
endif()
file(WRITE "${route_root}/plan.json" "${matrix_plan}")
file(WRITE "${route_root}-verify/verify.json" "${matrix_verify}")
string(REPLACE "\"seed\":0" "\"seed\":1" wrong_checkpoint "${matrix_plan}")
file(WRITE "${route_root}/plan.json" "${wrong_checkpoint}")
run_selected(matrix-wrong-checkpoint FALSE --group matrix-c16 --matrix "${WORK}/matrix.json")
if(NOT selected MATCHES "matrix_options_mismatch" OR
   NOT selected MATCHES "\"solver_native_updates\":30")
