file(READ "${WORK}/matrix.json" matrix_document)
string(REPLACE "easy-t0-b-s0" "easy-t0-a-s0" duplicate_matrix "${matrix_document}")
file(WRITE "${WORK}/matrix-duplicate.json" "${duplicate_matrix}")
run_selected(matrix-duplicate FALSE --group matrix-c16 --matrix "${WORK}/matrix-duplicate.json")
string(JSON incomplete_matrix REMOVE "${matrix_document}" cases 0)
file(WRITE "${WORK}/matrix-incomplete.json" "${incomplete_matrix}")
run_selected(matrix-incomplete FALSE --group matrix-c16 --matrix "${WORK}/matrix-incomplete.json")

# Matrix validation always requires process receipts, even in legacy-named groups.
file(COPY "${WORK}/results/matrix-c16/" DESTINATION "${WORK}/matrix-default/story-v2")
file(REMOVE "${WORK}/matrix-default/story-v2/${route_id}-verify.exit")
execute_process(COMMAND "${REPORT}" --root "${WORK}/matrix-default"
  --fidelity "${WORK}/fidelity.json" --matrix "${WORK}/matrix.json"
  --output "${WORK}/matrix-default.json" RESULT_VARIABLE matrix_result)
file(READ "${WORK}/matrix-default.json" missing_process)
