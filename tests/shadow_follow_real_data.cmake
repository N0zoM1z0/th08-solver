cmake_minimum_required(VERSION 3.16)
file(MAKE_DIRECTORY "${WORK}")
set(profile --dat "${DAT}" --stage 6b --difficulty 0 --seed 0)
execute_process(COMMAND "${PRODUCER}" ${profile} --spell-id 179 --strategy spell-portfolio
  --frames 2000 --actions "${WORK}/id179.actions" --output "${WORK}/control.json"
  RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 30)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Full-scene control failed: ${result} ${error}")
endif()
function(expect content key value)
  string(REGEX MATCH "\"${key}\":[ ]*${value}([,} \r\n\t]|$)" matched "${content}")
  if(NOT matched)
    message(FATAL_ERROR "Expected ${key}=${value}: ${content}")
  endif()
endfunction()
execute_process(COMMAND "${FOLLOWER}" ${profile} --spell 179 --actions "${WORK}/id179.actions"
  --output "${WORK}/follow.json" RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 30)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Independent follower failed: ${result} ${error}")
endif()
file(READ "${WORK}/follow.json" followed)
expect("${followed}" outcome "\"complete\"")
expect("${followed}" updates 1292)
expect("${followed}" calculation_updates 1292)
expect("${followed}" first_mismatch "\"\"")
expect("${followed}" future_native_updates 0)
expect("${followed}" deaths 0)
file(SHA256 "${DAT}" dat_hash)
file(SHA256 "${FOLLOWER}" binary_hash)
file(SHA256 "${WORK}/id179.actions" actions_hash)
expect("${followed}" dat_sha256 "\"${dat_hash}\"")
expect("${followed}" binary_sha256 "\"${binary_hash}\"")
expect("${followed}" actions_sha256 "\"${actions_hash}\"")
execute_process(COMMAND "${FOLLOWER}" ${profile} --spell 179 --follower-seed 1
  --actions "${WORK}/id179.actions" --output "${WORK}/mismatch.json"
  RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 30)
if(NOT result STREQUAL "3")
  message(FATAL_ERROR "Mismatched start was not rejected: ${result} ${error}")
endif()
file(READ "${WORK}/mismatch.json" mismatch)
expect("${mismatch}" outcome "\"desynchronized\"")
expect("${mismatch}" updates 0)
expect("${mismatch}" first_mismatch "\"rng_seed\"")
execute_process(COMMAND "${FOLLOWER}" --dat "${DAT}" --stage 1 --story 1 --difficulty 3
  --shot 1 --seed 0 --frames 32000 --actions "${STORY_ACTIONS}" --output "${WORK}/handoff.json"
  RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 60)
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Natural story handoff failed: ${result} ${error}")
endif()
file(READ "${WORK}/handoff.json" handoff)
expect("${handoff}" outcome "\"budget\"")
expect("${handoff}" updates 32000)
expect("${handoff}" calculation_updates 31999)
expect("${handoff}" handoffs 1)
expect("${handoff}" first_mismatch "\"\"")
expect("${handoff}" deaths 0)
