cmake_minimum_required(VERSION 3.16)
# The native loader bypasses the retail executable whitelist. Inspect the
# serialized file identity explicitly so that bypass cannot certify export.
include("${CMAKE_CURRENT_LIST_DIR}/headless_report_checks.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${EXECUTABLE}" --dat "${DAT}" --out "${WORK}/export"
  --stage 1 --difficulty 3 --seed 0 --story 0 --verify "${ACTIONS}"
  RESULT_VARIABLE verified TIMEOUT 60 OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT verified STREQUAL "0")
  message(FATAL_ERROR "Fresh complete export failed: ${stdout} ${stderr}")
endif()
execute_process(COMMAND "${CHECKER}" "${DAT}" "${WORK}/export/th8_verify.rpy" "${WORK}/replay.rows"
  RESULT_VARIABLE checked TIMEOUT 60 OUTPUT_VARIABLE replay ERROR_VARIABLE stderr)
if(NOT checked STREQUAL "0")
  message(FATAL_ERROR "Natural export replay failed: ${replay} ${stderr}")
endif()
file(READ "${WORK}/export/verify.json" verification)
field("${verification}" frames frames)
field("${verification}" score score)
field("${replay}" rows rows)
field("${replay}" endScore replay_score)
if(NOT rows STREQUAL frames OR NOT replay_score STREQUAL score)
  message(FATAL_ERROR "Export changed the complete tape outcome: ${verification} ${replay}")
endif()
function(expect key expected)
  string(REGEX MATCH "\"${key}\":[ ]*${expected}([,} \r\n\t]|$)" found "${replay}")
  if(NOT found)
    message(FATAL_ERROR "Serialized replay must have ${key}=${expected}: ${replay}")
  endif()
endfunction()
expect(replay_target_exe_size 840704)
expect(replay_target_exe_checksum 2724749753)
expect(replay_target_version "\"0100d\"")
expect(natural true)
expect(finished true)
expect(death_rows 0)
expect(bomb_input_rows 0)
file(WRITE "${WORK}/replay.json" "${replay}")

# Saved zero-identity artifacts stay immutable. A repaired copy must preserve the
# complete native execution, and repeating the operation must preserve the file.
execute_process(COMMAND "${TARGETER}" "${LEGACY_REPLAY}" "${WORK}/retargeted.rpy"
  RESULT_VARIABLE targeted OUTPUT_VARIABLE receipt ERROR_VARIABLE stderr TIMEOUT 10)
if(NOT targeted STREQUAL "0")
  message(FATAL_ERROR "Legacy identity repair failed: ${receipt} ${stderr}")
endif()
file(WRITE "${WORK}/retargeted.json" "${receipt}")
foreach(kind IN ITEMS legacy retargeted)
  if(kind STREQUAL "legacy")
    set(input "${LEGACY_REPLAY}")
  else()
    set(input "${WORK}/retargeted.rpy")
  endif()
  execute_process(COMMAND "${CHECKER}" "${DAT}" "${input}" "${WORK}/${kind}.rows"
    RESULT_VARIABLE checked OUTPUT_VARIABLE replay ERROR_VARIABLE stderr TIMEOUT 60)
  if(NOT checked STREQUAL "0")
    message(FATAL_ERROR "${kind} replay failed: ${replay} ${stderr}")
  endif()
  expect(natural true)
  expect(finished true)
  expect(death_rows 0)
  expect(bomb_input_rows 0)
  if(kind STREQUAL "legacy")
    expect(replay_target_exe_size 0)
    expect(replay_target_exe_checksum 0)
  else()
    expect(replay_target_exe_size 840704)
    expect(replay_target_exe_checksum 2724749753)
    expect(replay_target_version "\"0100d\"")
  endif()
endforeach()
file(SHA256 "${WORK}/legacy.rows" legacy_rows)
file(SHA256 "${WORK}/retargeted.rows" retargeted_rows)
if(NOT legacy_rows STREQUAL retargeted_rows)
  message(FATAL_ERROR "Identity repair changed native execution")
endif()
execute_process(COMMAND "${TARGETER}" "${WORK}/retargeted.rpy" "${WORK}/unchanged.rpy"
  RESULT_VARIABLE targeted OUTPUT_VARIABLE receipt ERROR_VARIABLE stderr TIMEOUT 10)
if(NOT targeted STREQUAL "0" OR NOT receipt MATCHES "\"changed\":false")
  message(FATAL_ERROR "Correct identity must be idempotent: ${receipt} ${stderr}")
endif()
file(SHA256 "${WORK}/retargeted.rpy" expected_file)
file(SHA256 "${WORK}/unchanged.rpy" unchanged_file)
if(NOT unchanged_file STREQUAL expected_file)
  message(FATAL_ERROR "Already targeted input changed")
endif()
execute_process(COMMAND "${TARGETER}" "${LEGACY_REPLAY}" "${WORK}/retargeted.rpy"
  RESULT_VARIABLE refused OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
file(SHA256 "${WORK}/retargeted.rpy" preserved_file)
if(NOT refused STREQUAL "2" OR NOT preserved_file STREQUAL expected_file)
  message(FATAL_ERROR "Repair must reject an existing output without modifying it")
endif()
file(WRITE "${WORK}/malformed.rpy" "T8RP")
execute_process(COMMAND "${TARGETER}" "${WORK}/malformed.rpy" "${WORK}/invalid-output.rpy"
  RESULT_VARIABLE refused OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
if(NOT refused STREQUAL "2" OR EXISTS "${WORK}/invalid-output.rpy")
  message(FATAL_ERROR "Malformed input must fail before writing any output")
endif()

# A live/truncated command map cannot certify that a recording completed. Reject
# it before constructing the native world or leaving an apparently valid replay.
file(MAKE_DIRECTORY "${WORK}/unfinished-recording")
file(WRITE "${WORK}/unfinished-recording/start.txt"
  "TH08_SHADOW_START_V2 0 0 3 1 1 -1 350000 228 1 1\n330fbdbf58a710829d65277b4f312cfbb38d5448b3df523e79350b879213d924\n")
file(WRITE "${WORK}/unfinished-recording/commands.bin" "unfinished")
execute_process(COMMAND "${SHADOW_EXPORTER}" "${DAT}" "${WORK}/unfinished-recording"
  "${WORK}/unfinished.rpy" RESULT_VARIABLE refused ERROR_VARIABLE error TIMEOUT 10)
if(NOT refused STREQUAL "2" OR EXISTS "${WORK}/unfinished.rpy" OR
    NOT error MATCHES "shadow_export_requires_completed_owner")
  message(FATAL_ERROR "Incomplete live recording was exported: ${refused} ${error}")
endif()
