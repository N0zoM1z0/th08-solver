cmake_minimum_required(VERSION 3.16)
# Opt-in native reconstruction/continuation contract; all lengths come from the
# solved tape on this host. Fresh replay checks execution, not independent physics.
include("${CMAKE_CURRENT_LIST_DIR}/headless_report_checks.cmake")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(SHA256 "${DAT}" dat_hash)
file(SHA256 "${EXECUTABLE}" binary_hash)
set(profile --stage 4b --spell 92 --difficulty 3 --seed 0 --shot 0
  --rollout 64 --diversity-cell 16 --shoot 1 --beam 384 --commit 8
  --checkpoint 60 --keep 12 --attempts 4 --cegar 4 --frames 10000 --seconds 180)

function(run name expected)
  execute_process(COMMAND "${EXECUTABLE}" --dat "${DAT}" --out "${WORK}/${name}"
    ${profile} ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr
    TIMEOUT 210)
  if(NOT result STREQUAL "${expected}")
    message(FATAL_ERROR "${name}: expected exit ${expected}, got ${result}: ${stdout} ${stderr}")
  endif()
endfunction()

function(expect report key expected)
  # These expectations are literal scalar values, including JSON quotes/bools.
  string(REGEX MATCH "\"${key}\":[ ]*${expected}([,} \r\n\t]|$)" found "${report}")
  if(NOT found)
    message(FATAL_ERROR "Expected ${key}=${expected}: ${report}")
  endif()
endfunction()

function(agree_state left right)
  foreach(key IN ITEMS frames score rng_seed rng_draws dat_sha256 binary_sha256)
    field("${left}" "${key}" a)
    field("${right}" "${key}" b)
    if(NOT a STREQUAL b)
      message(FATAL_ERROR "Fresh native state differs at ${key}: ${a} vs ${b}")
    endif()
  endforeach()
endfunction()

function(check_cost report prefix_count)
  foreach(key IN ITEMS native_updates native_update_attempts rollout_updates commit_updates)
    field("${report}" "${key}" "${key}")
  endforeach()
  math(EXPR total "${prefix_count} + ${rollout_updates} + ${commit_updates}")
  if(NOT native_updates EQUAL total OR NOT native_update_attempts EQUAL total)
    message(FATAL_ERROR "Native costs omitted prefix, retry or rollout updates: ${report}")
  endif()
  expect("${report}" prefix_native_updates "${prefix_count}")
  expect("${report}" prefix_native_update_attempts "${prefix_count}")
  expect("${report}" incomplete_native_updates 0)
  expect("${report}" dat_sha256 "\"${dat_hash}\"")
  expect("${report}" binary_sha256 "\"${binary_hash}\"")
endfunction()

function(verify name tape report)
  run("${name}" 0 --verify "${tape}")
  file(READ "${WORK}/${name}/verify.json" replay)
  field("${report}" frames frames)
  expect("${replay}" verified true)
  expect("${replay}" death_updates 0)
  expect("${replay}" complete_at "${frames}")
  expect("${replay}" native_updates "${frames}")
  agree_state("${report}" "${replay}")
endfunction()

run(solve 0)
file(READ "${WORK}/solve/plan.json" solved)
expect("${solved}" outcome "\"complete\"")
expect("${solved}" deaths 0)
expect("${solved}" final_spell 92)
expect("${solved}" final_spell_active false)
check_cost("${solved}" 0)
field("${solved}" frames terminal)
file(STRINGS "${WORK}/solve/plan.actions" actions)
list(LENGTH actions action_count)
if(NOT terminal GREATER 5 OR NOT terminal EQUAL action_count)
  message(FATAL_ERROR "Solved tape does not cover its measured terminal: ${solved}")
endif()
verify(solve-verify "${WORK}/solve/plan.actions" "${solved}")

math(EXPR prefix_count "${terminal} - 5")
list(SUBLIST actions 0 "${prefix_count}" prefix_actions)
string(REPLACE ";" "\n" prefix_text "${prefix_actions}")
file(WRITE "${WORK}/prefix.actions" "${prefix_text}\n")
file(SHA256 "${WORK}/prefix.actions" prefix_hash)
run(resume 0 --prefix "${WORK}/prefix.actions")
file(READ "${WORK}/resume/plan.json" resumed)
expect("${resumed}" outcome "\"complete\"")
expect("${resumed}" deaths 0)
expect("${resumed}" prefix_requested_frames "${prefix_count}")
expect("${resumed}" prefix_complete true)
expect("${resumed}" prefix_sha256 "\"${prefix_hash}\"")
check_cost("${resumed}" "${prefix_count}")
file(STRINGS "${WORK}/resume/plan.actions" resumed_actions)
list(SUBLIST resumed_actions 0 "${prefix_count}" retained_prefix)
list(LENGTH resumed_actions resumed_count)
field("${resumed}" frames resumed_frames)
if(NOT retained_prefix STREQUAL prefix_actions OR NOT resumed_count EQUAL resumed_frames)
  message(FATAL_ERROR "Continuation lost or changed its replayed prefix")
endif()
verify(resume-verify "${WORK}/resume/plan.actions" "${resumed}")

file(SHA256 "${WORK}/solve/plan.actions" complete_hash)
run(exact 0 --prefix "${WORK}/solve/plan.actions")
file(READ "${WORK}/exact/plan.json" exact)
expect("${exact}" outcome "\"complete\"")
expect("${exact}" deaths 0)
expect("${exact}" prefix_complete true)
expect("${exact}" prefix_requested_frames "${terminal}")
expect("${exact}" prefix_sha256 "\"${complete_hash}\"")
foreach(key IN ITEMS rollouts searches rollout_updates commit_updates)
  expect("${exact}" "${key}" 0)
endforeach()
check_cost("${exact}" "${terminal}")
agree_state("${solved}" "${exact}")

string(REPLACE ";" "\n" complete_text "${actions}")
file(WRITE "${WORK}/trailing.actions" "${complete_text}\n4\n")
file(SHA256 "${WORK}/trailing.actions" trailing_hash)
math(EXPR trailing_count "${terminal} + 1")
run(trailing 2 --prefix "${WORK}/trailing.actions")
file(READ "${WORK}/trailing/plan.json" rejected)
expect("${rejected}" outcome "\"prefix_rejected\"")
expect("${rejected}" prefix_complete false)
expect("${rejected}" prefix_requested_frames "${trailing_count}")
expect("${rejected}" prefix_sha256 "\"${trailing_hash}\"")
expect("${rejected}" rollouts 0)
expect("${rejected}" commit_updates 0)
check_cost("${rejected}" "${terminal}")
agree_state("${solved}" "${rejected}")
file(STRINGS "${WORK}/trailing/plan.actions" executed)
if(NOT executed STREQUAL actions)
  message(FATAL_ERROR "Rejected prefix executed or saved an action after terminal")
endif()
message(STATUS "Prefix continuation, exact terminal and trailing rejection passed at ${terminal} updates")
