+    check(session.bullets().front().vector_acceleration_updates == 0,
+          "fractional VECTOR clock accepted");
+    reset(1);
+    fixture.bullet.state = BULLET_STATE_SPAWNING_NORMAL;
+    check(session.bullets().front().vector_acceleration_updates == 0,
+          "non-FIRED VECTOR motion was certified");
+    reset(std::numeric_limits<int>::max());
+    fixture.bullet.exStates[BULLET_TRANSFORM_STATE_VECTOR_ACCELERATION].timer =
+        std::numeric_limits<int>::max() - 1;
+    const auto near_overflow = session.bullets().front();
+    check(near_overflow.vector_acceleration_updates == 1,
+          "VECTOR lost its safe prefix or included an overflowing update");
+    BulletManager::OnUpdate(&g_BulletManager);
+    check(policy::detail::project_bullet(near_overflow, 1).x == fixture.bullet.position.x &&
+              policy::detail::project_bullet(near_overflow, 2).kind ==
