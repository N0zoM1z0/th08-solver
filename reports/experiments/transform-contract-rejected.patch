+bool unit_bullet_motion_clock() {
+    return g_Supervisor.framerateMultiplier == 1.f && !g_GameManager.scriptedUpdateFreeze &&
+           !g_GameManager.flags.deathbombFreezeActive;
+}
+
+unsigned vector_acceleration_updates(const Bullet &bullet) {
+    const auto &state = bullet.exStates[BULLET_TRANSFORM_STATE_VECTOR_ACCELERATION];
+    if (!unit_bullet_motion_clock() || bullet.state != BULLET_STATE_FIRED ||
+        bullet.activeTransformFlags != BULLET_TRANSFORM_ACCELERATE_VECTOR ||
+        !active_transform_stays_single(bullet) || state.timer.current < 0 ||
+        state.timer.current == std::numeric_limits<int>::max() || state.timer.subFrame != 0.f ||
+        !std::isfinite(bullet.position.x) || !std::isfinite(bullet.position.y) ||
+        !std::isfinite(bullet.velocity.x) || !std::isfinite(bullet.velocity.y) ||
+        !std::isfinite(state.vector.x) || !std::isfinite(state.vector.y))
+        return 0;
+    // AdvanceTransformProgram precedes UpdateVectorAcceleration. A blocked
+    // record cannot start until the update after the final clear movement.
+    // Every active update, including clear, increments the signed timer. Stop
+    // before overflow without discarding a valid short prefix of a long duration.
+    const auto remaining =
+        std::max<std::int64_t>(0, std::int64_t(state.durationFrames) - state.timer.current);
+    const auto safe_increments =
+        std::int64_t(std::numeric_limits<int>::max()) - state.timer.current;
+    return unsigned(std::min(remaining + 1, safe_increments));
+}
