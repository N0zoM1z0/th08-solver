# Private game data, binaries and build trees.
/game_data_donottrack/
/game_exe/
/build*/
/.cache/
# Local run artifacts (episodes, tapes, run JSON, logs) never enter history.
/reports/local/
/preparations/
/gifs/
**/private_resources/
# New Native exports stay local by default. A selected record replay is added
# explicitly with `git add -f` together with its progress.tsv row.
/reports/native/**/*.json
/reports/native/**/*.rpy
/reports/native/**/*.actions
__pycache__/
*.py[cod]
.venv/
